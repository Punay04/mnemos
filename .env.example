GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local FalkorDB (started with `npm run memory:start`)
# Requires Docker. Browser UI: http://127.0.0.1:3000
# Hackathon: https://www.wemakedevs.org/hackathons/falkordb
# Source: https://github.com/FalkorDB/FalkorDB
# FALKORDB_HOST=127.0.0.1
# FALKORDB_PORT=6379
# FALKORDB_BROWSER_PORT=3000
# FALKORDB_GRAPH=chronicle
# FALKORDB_PASSWORD=
# FALKORDB_IMAGE=falkordb/falkordb:latest

# Live voice
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Aoede

# Optional app connections through Composio
# COMPOSIO_API_KEY=your_composio_api_key_here
